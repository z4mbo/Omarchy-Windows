+/*
+ * Discard private anonymous guest RAM without changing its virtual address.
+ * MEM_RESET cannot be used here: the balloon promises that discarded pages
+ * read back as zero, and MEM_RESET does not make that guarantee.  Decommit
+ * releases the physical backing; recommit restores the same reserved range
+ * with demand-zero pages (which consume physical RAM only when touched).
+ */
+int qemu_anon_ram_discard(void *ptr, size_t size)
+{
+    SYSTEM_INFO info;
+
+    GetSystemInfo(&info);
+    if (!ptr || !size || (uintptr_t)ptr % info.dwPageSize ||
+        size % info.dwPageSize) {
+        error_report("%s: guest RAM range is not page-aligned", __func__);
+        return -EINVAL;
+    }
+
+    if (!VirtualFree(ptr, size, MEM_DECOMMIT)) {
+        error_report("%s: MEM_DECOMMIT failed (Windows error %lu)",
+                     __func__, (unsigned long)GetLastError());
+        return -EIO;
+    }
+
+    if (VirtualAlloc(ptr, size, MEM_COMMIT, PAGE_READWRITE) != ptr) {
+        /* Continuing would leave guest RAM inaccessible at its registered
+         * address.  This path is experimental and explicitly opted into. */
+        error_report("%s: MEM_COMMIT failed after decommit "
+                     "(Windows error %lu); stopping QEMU",
+                     __func__, (unsigned long)GetLastError());
+        abort();
+    }
+
+    return 0;
+}
