+##
+# @__omarchy_native-foreground-handoff:
+#
+# Experimental Windows SDL-only foreground permission handoff.
+# QEMU verifies the native grant, process creation time, short uptime
+# deadline and its foreground SDL window before delegating permission.
+# This requires private host QMP transport; QAPI cannot identify its
+# caller.
+#
+# @hwnd: Native top-level window handle, encoded without truncation.
+#
+# @pid: Exact native process ID; zero and ASFW_ANY are rejected.
+#
+# @created: Expected process creation FILETIME as a 64-bit integer.
+#
+# @property: Exact per-session Omarchy window grant property name.
+#
+# @incarnation: Nonzero grant value attached to this window instance.
+#
+# @expires: Absolute GetTickCount64 deadline, in milliseconds; must be
+#     in the future and at most 250 milliseconds ahead when executed.
+#
+# Since: 11.0 (downstream)
+##
+{ 'command': '__omarchy_native-foreground-handoff',
+  'data': { 'hwnd': 'uint64', 'pid': 'uint32', 'created': 'uint64',
+            'property': 'str', 'incarnation': 'uint64', 'expires': 'uint64' },
+  'if': 'CONFIG_WIN32' }
