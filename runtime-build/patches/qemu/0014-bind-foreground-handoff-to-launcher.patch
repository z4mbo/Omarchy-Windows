+    FILETIME created, exited, kernel, user, qemu_created;
+    HANDLE snapshot, parent = NULL;
+    DWORD pid = 0, current_session, parent_session;
+
+    if (omarchy_launcher_attempted) {
+        return;
+    }
+    omarchy_launcher_attempted = true;
+    snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
+    if (snapshot == INVALID_HANDLE_VALUE) {
+        return;
+    }
+    if (Process32FirstW(snapshot, &entry)) {
+        do {
+            if (entry.th32ProcessID == GetCurrentProcessId()) {
+                pid = entry.th32ParentProcessID;
+                break;
+            }
+        } while (Process32NextW(snapshot, &entry));
+    }
+    CloseHandle(snapshot);
+    if (!pid || pid == GetCurrentProcessId() || pid == UINT32_MAX) {
+        return;
+    }
+    parent = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE,
+                         FALSE, pid);
+    if (!parent || WaitForSingleObject(parent, 0) != WAIT_TIMEOUT ||
+        GetProcessId(parent) != pid ||
+        !GetProcessTimes(parent, &created, &exited, &kernel, &user) ||
+        !GetProcessTimes(GetCurrentProcess(), &qemu_created, &exited,
+                         &kernel, &user) ||
+        omarchy_filetime(created) >= omarchy_filetime(qemu_created) ||
+        !ProcessIdToSessionId(GetCurrentProcessId(), &current_session) ||
+        !ProcessIdToSessionId(pid, &parent_session) ||
+        current_session != parent_session) {
+        if (parent) {
+            CloseHandle(parent);
+        }
+        return;
+    }
+    omarchy_launcher_pid = pid;
+    omarchy_launcher_created = omarchy_filetime(created);
+    omarchy_launcher_process = parent;
+}
 
