diff --git a/guest/tests/test_update_gate.py b/guest/tests/test_update_gate.py
new file mode 100644
index 0000000..6f3f93e
--- /dev/null
+++ b/guest/tests/test_update_gate.py
@@ -0,0 +1,96 @@
+"""The installed update entry points fail closed without a package transaction."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+
+OVERLAY = Path(__file__).resolve().parents[1] / "factory-overlay"
+GATE = OVERLAY / "usr/local/lib/try-omarchy/update-gate"
+COMMANDS = {
+    "omarchy-update": "update",
+    "omarchy-channel-set": "channel",
+    "omarchy-update-available": "available",
+}
+
+
+class UpdateGateTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.root = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.root, True)
+        self.bin = self.root / "bin"
+        self.bin.mkdir()
+        self.calls = self.root / "calls"
+        for name in ("pacman", "yay", "sudo", "omarchy-refresh-pacman", "curl", "git", "zenity", "notify-send"):
+            command = self.bin / name
+            command.write_text(f'#!/bin/sh\nprintf "%s\\n" "{name}" >>"{self.calls}"\nexit 95\n')
+            command.chmod(0o755)
+        self.env = dict(os.environ, PATH=f"{self.bin}:{os.environ['PATH']}")
+        self.env.pop("WAYLAND_DISPLAY", None)
+        self.env.pop("DISPLAY", None)
+
+    def run_gate(self, action: str, *args: str) -> subprocess.CompletedProcess[str]:
+        return subprocess.run(["bash", str(GATE), action, *args], env=self.env,
+                              capture_output=True, text=True, timeout=5)
+
+    def assert_no_package_or_network_command(self) -> None:
+        self.assertFalse(self.calls.exists(), self.calls.read_text() if self.calls.exists() else "")
+
+    def test_update_menu_cli_and_unattended_entry_fail_closed(self) -> None:
+        for args in ((), ("-y",)):
+            with self.subTest(args=args):
+                result = self.run_gate("update", *args)
+                self.assertEqual(result.returncode, 1)
+                self.assertIn("No packages were changed", result.stderr)
+                self.assertIn("About and updates", result.stderr)
+                self.assert_no_package_or_network_command()
+
+    def test_every_upstream_channel_name_is_guarded(self) -> None:
+        for channel in ("stable", "rc", "edge", "dev"):
+            with self.subTest(channel=channel):
+                result = self.run_gate("channel", channel)
+                self.assertEqual(result.returncode, 1)
+                self.assertIn("not changed", result.stderr)
+                self.assert_no_package_or_network_command()
+
+    def test_invalid_inputs_do_not_start_update(self) -> None:
+        for action, args in (("update", ("--force",)), ("update", ("-y", "extra")),
+                             ("channel", ()), ("channel", ("unknown",)),
+                             ("available", ("extra",)), ("unknown", ())):
+            with self.subTest(action=action, args=args):
+                self.assertEqual(self.run_gate(action, *args).returncode, 2)
+                self.assert_no_package_or_network_command()
+
+    def test_badge_does_not_advertise_unapproved_upstream_updates(self) -> None:
+        result = self.run_gate("available")
+        self.assertEqual(result.returncode, 1)
+        self.assertIn("managed by the Windows launcher", result.stdout)
+        self.assert_no_package_or_network_command()
+
+    def test_graphical_update_attempt_shows_a_bounded_notice(self) -> None:
+        if not hasattr(os, "geteuid") or os.geteuid() == 0:
+            self.skipTest("graphical guest notice is shown for a normal user")
+        self.env["WAYLAND_DISPLAY"] = "wayland-test"
+        result = self.run_gate("update")
+        self.assertEqual(result.returncode, 1)
+        self.assertEqual(self.calls.read_text(), "zenity\n")
+
+    def test_installed_commands_route_to_fork_gate(self) -> None:
+        for name, action in COMMANDS.items():
+            with self.subTest(name=name):
+                wrapper = OVERLAY / "usr/bin" / name
+                content = wrapper.read_text()
+                self.assertTrue(content.startswith("#!/bin/bash\n"))
+                self.assertIn(f'exec /usr/local/lib/try-omarchy/update-gate {action} "$@"', content)
+                self.assertNotIn("pacman", content)
+                self.assertTrue(wrapper.stat().st_mode & 0o111)
+        self.assertTrue(GATE.stat().st_mode & 0o111)
+
+
+if __name__ == "__main__":
+    unittest.main()
