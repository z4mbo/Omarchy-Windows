diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/update-gate b/guest/factory-overlay/usr/local/lib/try-omarchy/update-gate
new file mode 100755
index 0000000..cb60f2c
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/update-gate
@@ -0,0 +1,50 @@
+#!/bin/bash
+# The default guest update commands must not run a moving pacman/AUR or
+# upstream-channel transaction before the Windows launcher can checkpoint the
+# stopped disk and apply an authenticated, tested package plan.
+set -euo pipefail
+
+action=${1:-}
+[[ $# -gt 0 ]] && shift
+
+notice() {
+  local message=$1
+  printf '%s\n' "$message" >&2
+  if [[ -n ${WAYLAND_DISPLAY:-}${DISPLAY:-} && $EUID -ne 0 ]]; then
+    if command -v zenity >/dev/null 2>&1; then
+      timeout 30 zenity --warning --title='Omarchy updates' --width=520 --text="$message" >/dev/null 2>&1 || true
+    elif command -v notify-send >/dev/null 2>&1; then
+      notify-send -a 'Omarchy' -u normal -t 20000 'Omarchy updates' "$message" >/dev/null 2>&1 || true
+    fi
+  fi
+}
+
+case "$action" in
+  update)
+    if [[ $# -gt 1 || ( $# -eq 1 && $1 != -y ) ]]; then
+      printf 'Usage: omarchy-update [-y]\n' >&2
+      exit 2
+    fi
+    notice 'Omarchy package updates are waiting for a validated Windows update path. No packages were changed. In the Windows Omarchy app, Settings > About and updates checks signed launcher releases. Guest package installation will be offered only after a tested update plan and stopped-disk recovery are available.'
+    exit 1
+    ;;
+  channel)
+    if [[ $# -ne 1 || ! $1 =~ ^(stable|rc|edge|dev)$ ]]; then
+      printf 'Usage: omarchy-channel-set <stable|rc|edge|dev>\n' >&2
+      exit 2
+    fi
+    notice "Switching to the $1 channel is waiting for a validated Windows update plan. Your channel and packages were not changed. Check signed launcher releases in Windows Omarchy Settings > About and updates."
+    exit 1
+    ;;
+  available)
+    [[ $# -eq 0 ]] || exit 2
+    # The upstream badge checks live package repositories. Suppress that
+    # misleading signal until a fork-approved plan can be queried instead.
+    printf 'Omarchy Windows updates are managed by the Windows launcher.\n'
+    exit 1
+    ;;
+  *)
+    printf 'Unknown Omarchy update action\n' >&2
+    exit 2
+    ;;
+esac
