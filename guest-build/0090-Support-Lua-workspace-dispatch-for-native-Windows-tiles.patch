+def dispatch_workspace_move(workspace: int, address: str, syntax: str | None) -> str | None:
+    """Cache the working syntax; only a Lua parser hint triggers fallback."""
+    primary = syntax or "legacy"
+    try:
+        result = subprocess.run(workspace_move_command(workspace, address, primary),
+                                capture_output=True, text=True,
+                                timeout=HYPRCTL_TIMEOUT, check=False)
+    except (OSError, subprocess.SubprocessError):
+        return syntax
+    if result.returncode == 0:
+        return primary
+    if primary != "legacy" or not legacy_dispatch_needs_lua(result.stdout + result.stderr):
+        return syntax
+    try:
+        result = subprocess.run(workspace_move_command(workspace, address, "lua"),
+                                capture_output=True, text=True,
+                                timeout=HYPRCTL_TIMEOUT, check=False)
+    except (OSError, subprocess.SubprocessError):
+        return syntax
+    return "lua" if result.returncode == 0 else syntax
+
+
