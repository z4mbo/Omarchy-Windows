         return self.run_script(CATCH_UP, TRY_OMARCHY_COMPAT_VERSION=str(self.version), TRY_OMARCHY_STATE_DIR=str(self.state),
                                TRY_OMARCHY_QEMU_FRAGMENT=str(FRAGMENT), TRY_OMARCHY_OMARCHY_MONITORS=str(self.default),
                                TRY_OMARCHY_TOGGLE_TEMPLATES=str(self.templates), TRY_OMARCHY_HOMES=str(self.homes),
-                               TRY_OMARCHY_OMARCHY_VERSION=str(self.omarchy_version))
+                               TRY_OMARCHY_OMARCHY_VERSION=str(self.omarchy_version),
+                               TRY_OMARCHY_MODULE_ROOT=str(self.module_root), TRY_OMARCHY_VDSO_HASHES=str(self.vdso_hashes),
+                               PACMAN_MODE=pacman_mode)
+
+    def seed_old_compat_vdso(self) -> Path:
+        kernel = "7.2.7-arch1-1"
+        self.version.write_text(f"36:{kernel}\n")
+        tree = self.module_root / kernel
+        vdso = tree / "vdso"
+        vdso.mkdir(parents=True)
+        (tree / ".tryomarchy-complete").write_text(f"36:{kernel}\n")
+        hashes = []
+        for name in ("vdso32.so", "vdso64.so", "vdsox32.so"):
+            data = f"packaged {name}".encode()
+            (vdso / name).write_bytes(data)
+            hashes.append(f"{hashlib.sha256(data).hexdigest()}  {name}\n")
+        self.vdso_hashes.write_text("".join(hashes))
+        self.fake("pacman", '''case "$PACMAN_MODE" in
+  owned) echo linux-headers; exit 0 ;;
+  error) echo 'error: database unavailable' >&2; exit 2 ;;
+  unowned) printf 'error: No package owns %s\\n' "${@: -1}" >&2; exit 1 ;;
+esac
+exit 3''')
+        return vdso
+
+    def test_revision_36_removes_only_authenticated_unowned_vdso(self) -> None:
+        vdso = self.seed_old_compat_vdso()
+        self.state.mkdir()
+        (self.state / "catch-up-revision").write_text("35\n")
+        (vdso.parent / "keep-user-module").write_text("preserve")
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual((self.state / "catch-up-revision").read_text().strip(), "36")
+        self.assertEqual((vdso.parent / "keep-user-module").read_text(), "preserve")
+        self.assertEqual(list(vdso.iterdir()), [])
+
+    def test_revision_36_preserves_package_owned_vdso(self) -> None:
+        vdso = self.seed_old_compat_vdso()
+        result = self.run_catch_up("owned")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(len(list(vdso.iterdir())), 3)
+        self.assertEqual((self.state / "catch-up-revision").read_text().strip(), "36")
+
+    def test_revision_36_preserves_all_files_when_one_hash_differs(self) -> None:
+        vdso = self.seed_old_compat_vdso()
+        (vdso / "vdsox32.so").write_text("user changed")
+        result = self.run_catch_up()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(len(list(vdso.iterdir())), 3)
+        self.assertFalse((self.state / "catch-up-revision").exists())
+
+    def test_revision_36_refuses_ambiguous_ownership_query(self) -> None:
+        vdso = self.seed_old_compat_vdso()
+        result = self.run_catch_up("error")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(len(list(vdso.iterdir())), 3)
+        self.assertFalse((self.state / "catch-up-revision").exists())
+
+    def test_revision_36_refuses_symlinked_vdso_path(self) -> None:
+        vdso = self.seed_old_compat_vdso()
+        original = vdso / "vdsox32.so"
+        original.rename(vdso / "custom.so")
+        original.symlink_to("custom.so")
+        result = self.run_catch_up()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertTrue(original.is_symlink())
+        self.assertEqual(len(list(vdso.iterdir())), 4)
+        self.assertFalse((self.state / "catch-up-revision").exists())
+
+    def test_revision_36_requires_completed_overlay_marker(self) -> None:
+        vdso = self.seed_old_compat_vdso()
+        (vdso.parent / ".tryomarchy-complete").unlink()
+        result = self.run_catch_up()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(len(list(vdso.iterdir())), 3)
+        self.assertFalse((self.state / "catch-up-revision").exists())
+
+    def test_revision_36_refuses_symlinked_vdso_directory(self) -> None:
+        vdso = self.seed_old_compat_vdso()
+        real_dir = vdso.parent / "vdso-original"
+        vdso.rename(real_dir)
+        vdso.symlink_to(real_dir, target_is_directory=True)
+        result = self.run_catch_up()
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(len(list(real_dir.iterdir())), 3)
+        self.assertFalse((self.state / "catch-up-revision").exists())
 
     def seed_toggles(self) -> None:
