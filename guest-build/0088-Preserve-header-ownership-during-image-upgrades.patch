index 54aef806945a6c47175224e1b33e608e254377d9..8639f9dc133c97e62b9705e1b17d8194fd36d9b3 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
@@ -18,12 +18,79 @@ omarchy_default=${TRY_OMARCHY_OMARCHY_MONITORS:-/usr/share/omarchy/config/hypr/m
 toggle_templates=${TRY_OMARCHY_TOGGLE_TEMPLATES:-/usr/share/omarchy/default/hypr/toggles}
 omarchy_version=${TRY_OMARCHY_OMARCHY_VERSION:-/usr/share/omarchy/version}
 homes=${TRY_OMARCHY_HOMES:-/home}
+module_root=${TRY_OMARCHY_MODULE_ROOT:-/usr/lib/modules}
+vdso_hashes=${TRY_OMARCHY_VDSO_HASHES:-/usr/share/try-omarchy/vdso-overlay.sha256}
 
-revision=$(cut -d: -f1 "$revision_file" 2>/dev/null || echo 0)
+revision_file_version=$(cat "$revision_file" 2>/dev/null || echo '0:')
+revision=${revision_file_version%%:*}
 marker="$state_dir/catch-up-revision"
 [[ "$(cat "$marker" 2>/dev/null || true)" != "$revision" ]] || exit 0
 mkdir -p "$state_dir"
 
+repair_compat_vdso() {
+  # Earlier initramfs overlays copied these three linux-headers files into
+  # older disks without pacman ownership. A later linux-headers transaction
+  # then refuses to overwrite them. Never remove an owned or modified file.
+  local kernel=${revision_file_version#*:} tree=$module_root/${revision_file_version#*:}
+  local dir=$tree/vdso name path expected actual ownership
+  local -a names=(vdso32.so vdso64.so vdsox32.so) lines removable=()
+  [[ $kernel =~ ^[A-Za-z0-9._+-]+$ && -f $vdso_hashes && ! -L $vdso_hashes ]] || {
+    echo "Cannot authenticate compatibility VDSO migration" >&2
+    return 1
+  }
+  mapfile -t lines < "$vdso_hashes"
+  [[ ${#lines[@]} -eq ${#names[@]} ]] || return 1
+  for i in "${!names[@]}"; do
+    [[ ${lines[$i]} =~ ^([0-9a-f]{64})[[:space:]][[:space:]](vdso32\.so|vdso64\.so|vdsox32\.so)$ ]] || return 1
+    [[ ${BASH_REMATCH[2]} == "${names[$i]}" ]] || return 1
+  done
+  [[ ! -L $module_root && ! -L $tree && ! -L $dir ]] || {
+    echo "Refusing symlinked compatibility module path" >&2
+    return 1
+  }
+  [[ -d $dir ]] || return 0
+  [[ -f $tree/.tryomarchy-complete && ! -L $tree/.tryomarchy-complete &&
+     $(cat "$tree/.tryomarchy-complete") == "$revision_file_version" ]] || {
+    echo "Cannot prove compatibility module overlay completed: $tree" >&2
+    return 1
+  }
+  # Check all three before removing any, so an unknown file never leaves the
+  # migration only partly applied. A later boot can retry after diagnosis.
+  for i in "${!names[@]}"; do
+    name=${names[$i]}
+    path=$dir/$name
+    [[ ! -e $path && ! -L $path ]] && continue
+    [[ -f $path && ! -L $path ]] || {
+      echo "Refusing non-regular compatibility VDSO: $path" >&2
+      return 1
+    }
+    if ownership=$(LC_ALL=C pacman -Qqo -- "$path" 2>&1); then
+      echo "Preserved package-owned VDSO: $path ($ownership)"
+      continue
+    fi
+    [[ $ownership == "error: No package owns $path" ]] || {
+      echo "Cannot prove VDSO is unowned: $path: $ownership" >&2
+      return 1
+    }
+    expected=${lines[$i]%% *}
+    actual=$(sha256sum -- "$path") || return 1
+    actual=${actual%% *}
+    [[ $actual == "$expected" ]] || {
+      echo "Preserved modified compatibility VDSO: $path" >&2
+      return 1
+    }
+    removable+=("$path")
+  done
+  for path in "${removable[@]}"; do
+    rm -- "$path"
+    echo "Removed old unowned compatibility VDSO: $path"
+  done
+}
+
+if [[ $revision =~ ^[0-9]+$ ]] && (( revision >= 36 )); then
+  repair_compat_vdso
+fi
+
 strip_profile_block() {
   # Drop our appended block so the remainder can be compared with Omarchy's own file.
   sed '/^-- BEGIN OMARCHY QEMU PROFILE$/,/^-- END OMARCHY QEMU PROFILE$/d' "$1" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}'
