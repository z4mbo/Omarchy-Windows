--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -72,11 +72,30 @@ version = subprocess.check_output(["pacman", "-Q", "try-omarchy-runtime"], text=
 (root / "manifest.json").write_text(json.dumps({"schema": 1, "runtimeVersion": version, "files": files}, sort_keys=True) + "\n")
 UPDATE_MANIFEST
 
+kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
+[[ -n $kernel_release && $kernel_release != *$'\n'* ]] || {
+  echo "Expected exactly one installed kernel module tree" >&2
+  exit 1
+}
+# Revision 36 can remove only old compatibility-copied VDSO objects whose
+# bytes match this authenticated image. The objects themselves stay owned by
+# linux-headers and are never placed in the compatibility module archive.
+vdso_dir=/usr/lib/modules/$kernel_release/vdso
+for name in vdso32.so vdso64.so vdsox32.so; do
+  [[ -f $vdso_dir/$name && ! -L $vdso_dir/$name ]] || {
+    echo "Missing packaged linux-headers VDSO object: $name" >&2
+    exit 1
+  }
+done
+(cd "$vdso_dir" && sha256sum vdso32.so vdso64.so vdsox32.so) \
+  > /usr/share/try-omarchy/vdso-overlay.sha256
+
 compat_paths=(
   usr/local/lib/try-omarchy/vulkan-env
   usr/share/uwsm/env.d/20-try-omarchy-vulkan
   etc/profile.d/try-omarchy-vulkan.sh
   usr/share/try-omarchy/system-owned-paths
+  usr/share/try-omarchy/vdso-overlay.sha256
   usr/local/lib/try-omarchy/repair-icon-names
   usr/local/lib/try-omarchy/repair-system-ownership
   etc/systemd/system/try-omarchy-system-ownership.service
@@ -153,11 +172,6 @@ compat_paths=(
   usr/local/lib/try-omarchy/show-factory-update-notice
 )
 tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
-kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
-[[ -n $kernel_release && $kernel_release != *$'\n'* ]] || {
-  echo "Expected exactly one installed kernel module tree" >&2
-  exit 1
-}
 # Bump this revision whenever compat-overlay.tar changes in a way that must be
 # applied to persistent disks created by an earlier launcher release. Revision
 # 22 carries the packaged Neovim theme symlink and its catch-up repair.
@@ -170,8 +184,9 @@ kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '
 # the transfer fallback when a direct paste cannot be confirmed.
 # Revision 28 receives file drops in the background directly into folders.
 # Revision 30 adds Windows Apps and first-run Moonlight launchers.
-# Revision 35 adds capability-negotiated native window clipping.
-compat_revision=35
+# Revision 35 adds capability-negotiated native window clipping. Revision 36
+# excludes package-owned VDSOs from the module overlay and repairs old copies.
+compat_revision=36
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
