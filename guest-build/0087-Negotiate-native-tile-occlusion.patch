         raise LayoutError("The host returned an invalid native presentation response.") from exc
 
@@ -79,7 +79,7 @@ def hidden_layout(output: dict, catalog: list[dict]) -> dict:
         for item in catalog]}
 
 
-def start_gtk(bridge: Bridge, lock_fd: int) -> int:
+def start_gtk(bridge: Bridge, lock_fd: int, max_occlusions: int) -> int:
     try:
         import gi
         gi.require_version("Gtk", "4.0")
@@ -126,6 +126,7 @@ def start_gtk(bridge: Bridge, lock_fd: int) -> int:
         def __init__(self):
             super().__init__(application_id="dev.omarchy.WindowsNative", flags=Gio.ApplicationFlags.NON_UNIQUE)
