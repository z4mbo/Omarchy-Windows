#!/usr/bin/env python3
"""Pick a host app, then opt into presenting its window inside Omarchy."""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import time

from omarchy_windows_protocol import Bridge, BridgeError, load_token


def message(text: str) -> None:
    print(text, file=sys.stderr)
    if os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"):
        executable = "/usr/bin/zenity"
        if Path(executable).exists():
            try:
                subprocess.run(
                    [executable, "--error", "--title=Windows Apps in Omarchy (Preview)", f"--text={text}", "--width=460"],
                    timeout=30,
                    check=False,
                )
            except (OSError, subprocess.TimeoutExpired):
                pass


def choose_window(windows: list[dict]) -> dict | None:
    if len(windows) == 1:
        return windows[0]
    if not windows:
        return None
    rows: list[str] = []
    for window in windows:
        rows.extend((window["title"] or window["process"] or "Windows app", window["process"], window["id"]))
    try:
        result = subprocess.run(
            ["zenity", "--list", "--title=Select Windows window to show in Omarchy (Preview)",
             "--width=700", "--height=480", "--column=Window", "--column=Process", "--column=ID",
             "--hide-column=3", "--print-column=3", *rows],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    selected = result.stdout.strip()
    return next((window for window in windows if window["id"] == selected), None)


def main() -> int:
    scripts = Path(__file__).resolve().parent
    presenter = scripts / "omarchy-windows-present"
    picker = scripts / "omarchy-windows-app"
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        message("Open this from the Omarchy desktop.")
        return 1
    if not presenter.is_file() or not picker.is_file():
        message("The Windows app integration is incomplete. Update Omarchy.")
        return 1
    try:
        bridge = Bridge(load_token())
        before = bridge.windows()
    except BridgeError as exc:
        message(str(exc))
        return 1
    if subprocess.run([str(presenter), "--probe"], check=False).returncode != 0:
        message("The per-window presenter is unavailable. Check GTK4 and the Omarchy Windows launcher.")
        return 1

    environment = dict(os.environ, OMARCHY_WINDOW_PREVIEW="1")
    result = subprocess.run([str(picker), "pick"], env=environment, check=False)
    if result.returncode == 3:
        return 0  # The user canceled the picker.
    if result.returncode != 0:
        message("Windows could not open that app on the host.")
        return 1

    old_ids = {window["id"] for window in before}
    new_windows: list[dict] = []
    all_windows = before
    deadline = time.monotonic() + 12
    while time.monotonic() < deadline:
        try:
            all_windows = bridge.windows()
        except BridgeError:
            time.sleep(0.3)
            continue
        new_windows = [window for window in all_windows if window["id"] not in old_ids]
        if new_windows:
            break
        time.sleep(0.3)

    selected = choose_window(new_windows or all_windows)
    if selected is None:
        message("The app opened on Windows, but no window was selected for the Omarchy preview. Use the host display or try again.")
        return 1
    try:
        subprocess.Popen(
            [str(presenter), "--id", selected["id"], "--group", selected["appGroup"]],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        message(f"Could not start the Omarchy window preview: {exc}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
